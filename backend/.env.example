# 복사해서 .env 로 저장한 뒤 값을 채우세요. .env는 깃에 올리지 마세요.

# 채팅 모델 (구조화, 시나리오, 검색 요약)
LLM_PROVIDER=openai
OPENAI_API_KEY=
# 쓸 채팅 모델 이름을 넣으세요
LLM_MODEL=

# 임베딩 (유사사고 검색, ChromaDB에 저장)
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small

# 대체 LLM: GPT 호출이 실패하면 Gemini로 다시 요청 (임베딩은 대체 없음)
GEMINI_API_KEY=
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-3.6-flash

# Anthropic으로 채팅 모델을 쓸 때 (임베딩은 위 OpenAI 그대로)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5

# 사내 GPU 등 OpenAI 호환 서버를 쓸 때
# OPENAI_BASE_URL=http://localhost:8000/v1
# EMBED_BASE_URL=http://localhost:8000/v1

# 새 보고서 자동 반영: 이 폴더에 PDF가 들어오면 자동 처리
# INBOX_DIR=inbox

# ---------- Supabase (배포용 DB). 비워 두면 로컬 파일 저장소(backend/data)를 쓴다 ----------
# Supabase 대시보드 > Connect > Session pooler 연결 문자열 (Direct는 IPv6 전용)
# DATABASE_URL=postgresql://postgres.<project-ref>:<DB 비밀번호>@aws-0-<region>.pooler.supabase.com:5432/postgres
# 원문 PDF 보관 (Storage). service_role 키는 서버에만 두고 브라우저·깃에 올리지 않는다
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# STORAGE_BUCKET=reports
