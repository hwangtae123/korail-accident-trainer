# 복사해서 .env 로 저장한 뒤 값을 채우세요. .env는 깃에 올리지 마세요.

# 채팅 모델 (구조화, 시나리오, 검색 요약)
LLM_PROVIDER=openai
OPENAI_API_KEY=
# 쓸 채팅 모델 이름을 넣으세요
LLM_MODEL=

# 임베딩 (유사사고 검색, ChromaDB에 저장)
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small

# Anthropic으로 채팅 모델을 쓸 때 (임베딩은 위 OpenAI 그대로)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5

# 사내 GPU 등 OpenAI 호환 서버를 쓸 때
# OPENAI_BASE_URL=http://localhost:8000/v1
# EMBED_BASE_URL=http://localhost:8000/v1

# 새 보고서 자동 반영: 이 폴더에 PDF가 들어오면 자동 처리
# INBOX_DIR=inbox
