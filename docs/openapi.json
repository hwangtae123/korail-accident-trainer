              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/{rid}/scenario/review": {
      "post": {
        "tags": [
          "scenario"
        ],
        "summary": "Mark Reviewed",
        "operationId": "mark_reviewed_api_reports__rid__scenario_review_post",
        "parameters": [
          {
            "name": "rid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Rid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ok"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "tags": [
          "analysis"
        ],
        "summary": "Stats",
        "description": "여러 보고서에 걸친 반복 패턴: 사고유형, 지적된 규정, 교육 관련 지적.",
        "operationId": "stats_api_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "post": {
        "tags": [
          "analysis"
        ],
        "summary": "Similar",
        "description": "상황 설명 -> 비슷한 과거 사고 (LLM 없이 검색만).",
        "operationId": "similar_api_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Query"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SearchGroup"
                  },
                  "type": "array",
                  "title": "Response Similar Api Search Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/ask": {
      "post": {
        "tags": [
          "analysis"
        ],
        "summary": "Ask",
        "description": "검색 결과를 근거로 LLM이 요약 (반복 원인, 확인할 점).",
        "operationId": "ask_api_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Query"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/briefing": {
      "post": {
        "tags": [
          "analysis"
        ],
        "summary": "Briefing",
        "description": "작업 전 안전 브리핑(TBM) 1장: 비슷한 과거 사고 3건 + 그 안전권고·기여요인에서 뽑은 확인 항목.\n확인 항목의 출처는 검색된 보고서로 코드가 검증한다. 색인된 보고서가 없으면 빈 결과.",
        "operationId": "briefing_api_briefing_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BriefingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Briefing"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reindex": {
      "post": {
        "tags": [
          "system"
        ],
        "summary": "Reindex",
        "operationId": "reindex_api_reindex_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReindexResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccidentRecord": {
        "properties": {
          "report_no": {
            "type": "string",
            "title": "Report No",
            "description": "보고서 번호 (예: ARAIB/R 2026-8)",
            "default": ""
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "occurred_at": {
            "type": "string",
            "title": "Occurred At",
            "description": "발생 일시",
            "default": ""
          },
          "location": {
            "type": "string",
            "title": "Location",
            "default": ""
          },
          "accident_type": {
            "type": "string",
            "enum": [
              "충돌",
              "탈선",
              "열차화재",
              "사상",
              "건널목",
              "철도안전사고",
              "기타"
            ],
            "title": "Accident Type",
            "default": "기타"
          },
          "vehicles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Vehicles",
            "description": "관련 열차·차량·장비"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "description": "사고 개요 2~3문장"
          },
          "damage": {
            "type": "string",
            "title": "Damage",
            "default": ""
          },
          "timeline": {
            "items": {
              "$ref": "#/components/schemas/TimelineEvent"
            },
            "type": "array",
            "title": "Timeline"
          },
          "direct_causes": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array",
            "title": "Direct Causes"
          },
          "contributing_factors": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array",
            "title": "Contributing Factors"
          },
          "violated_rules": {
            "items": {
              "$ref": "#/components/schemas/ViolatedRule"
            },
            "type": "array",
            "title": "Violated Rules"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/Recommendation"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "training_findings": {
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "type": "array",
            "title": "Training Findings",
            "description": "교육·훈련 관련 조사결과"
          }
        },
        "type": "object",
        "required": [
          "title",
          "summary"
        ],
        "title": "AccidentRecord"
      },
      "AskResult": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "groups": {
            "items": {
              "$ref": "#/components/schemas/SearchGroup"
            },
            "type": "array",
            "title": "Groups"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "groups"
        ],
        "title": "AskResult"
      },
      "Body_upload_api_reports_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_reports_post"
      },
      "Briefing": {
        "properties": {
          "work": {
            "type": "string",
            "title": "Work"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "description": "비슷한 과거 사고 요약 (근거 [제목 p.N] 포함)"
          },
          "checklist": {
            "items": {
              "$ref": "#/components/schemas/ChecklistItem"
            },
            "type": "array",
            "title": "Checklist"
          },
          "similar": {
            "items": {
              "$ref": "#/components/schemas/SearchGroup"
            },
            "type": "array",
            "title": "Similar"
          }
        },
        "type": "object",
        "required": [
          "work",
          "summary",
          "checklist",
          "similar"
        ],
        "title": "Briefing"
      },
      "BriefingRequest": {
        "properties": {
          "work": {
            "type": "string",
            "minLength": 1,
            "title": "Work",
            "description": "오늘 할 작업 설명 (장소, 작업 종류, 장비)"
          }
        },
        "type": "object",
        "required": [
          "work"
        ],
        "title": "BriefingRequest"
      },
      "ChecklistItem": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text",
            "description": "작업 전 확인할 항목 (과거 안전권고·기여요인에서 도출)"
          },
          "source_report_id": {
            "type": "string",
            "title": "Source Report Id"
          },
          "source_title": {
            "type": "string",
            "title": "Source Title"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          }
        },
        "type": "object",
        "required": [
          "text",
          "source_report_id",
          "source_title",
          "evidence"
        ],
        "title": "ChecklistItem"
      },
      "Evidence": {
        "properties": {
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page",
            "description": "근거가 있는 보고서 쪽 번호"
          },
          "quote": {
            "type": "string",
            "title": "Quote",
            "description": "원문에서 근거가 되는 짧은 구절 (40자 이내)",
            "default": ""
          },
          "verified": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verified",
            "description": "quote가 해당 쪽 원문에 실제로 있는지 코드로 대조한 결과. null = 아직 확인 안 함"
          }
        },
        "type": "object",
        "title": "Evidence",
        "description": "모든 추출 항목에 붙는 근거. 사람이 원문과 대조할 수 있게 쪽 번호를 남긴다."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Item": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence",
            "default": {
              "quote": ""
            }
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "Item"
      },
      "NameCount": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "name",
          "count"
        ],
        "title": "NameCount"
      },
      "Ok": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok",
            "default": true
          }
        },
        "type": "object",
        "title": "Ok"
      },
      "Option": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "title": "Option"
      },
