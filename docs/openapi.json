              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/{rid}/scenario": {
      "get": {
        "tags": [
          "scenario"
        ],
        "summary": "Get Scenario",
        "operationId": "get_scenario_api_reports__rid__scenario_get",
        "parameters": [
          {
            "name": "rid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Rid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scenario"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "scenario"
        ],
        "summary": "Update Scenario",
        "description": "교관이 고친 시나리오 저장. 저장하면 review_status는 '검수 전'으로 되돌린다.\n각 단계의 answer_id가 그 단계 선택지 id 중 하나가 아니면 422.",
        "operationId": "update_scenario_api_reports__rid__scenario_put",
        "parameters": [
          {
            "name": "rid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Rid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Scenario"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Scenario"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/{rid}/scenario/regenerate": {
      "post": {
        "tags": [
          "scenario"
        ],
        "summary": "Regenerate",
        "operationId": "regenerate_api_reports__rid__scenario_regenerate_post",
        "parameters": [
          {
            "name": "rid",
            "in": "path",
            "required": true,
